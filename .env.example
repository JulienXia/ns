# ── NativeSense environment ─────────────────────────────────
# Copy this file to `.env` and adjust values as needed.
# Never commit your real `.env` file (it is git-ignored).

# Port for the API server. The web app runs on Vite's dev port (5173).
PORT=3001

# AI provider: "ollama" (default — local, free, offline) or
# "openai" (any OpenAI-compatible API, e.g. OpenAI / DeepSeek / Qwen).
AI_PROVIDER=ollama

# Model used by the chosen provider.
AI_MODEL=qwen2.5:7b

# Local Ollama server (OpenAI-compatible endpoint). Change only if your
# Ollama runs on a different host/port.
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Only needed when AI_PROVIDER=openai ────────────────────
# Your API key. Stays on the server — never in frontend code.
OPENAI_API_KEY=
# Base URL of an OpenAI-compatible endpoint, e.g.
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
OPENAI_BASE_URL=

# Optional: directory where the Learning Bank JSON file is stored.
DATA_DIR=data
